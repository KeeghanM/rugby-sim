{
  "name": "rugby-sim",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "check:career": "node src/career/career.check.ts",
    "check:contracts": "node src/simulation/contracts.check.ts",
    "monte-carlo": "node src/monte-carlo.ts",
    "preview": "vite preview",
    "qa:format": "biome format --write . ",
    "qa:format:check": "biome ci .",
    "qa:lint": "biome lint . --write --unsafe"
  },
  "dependencies": {
    "@babylonjs/core": "^9.0.0",
    "@babylonjs/loaders": "^9.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.4.0",
    "vite": "^6.0.0"
  }
}
